{
  "name": "sera-mcp",
  "version": "0.8.3",
  "description": "Multi-currency MCP server backed by Sera (stablecoin FX). Lets any agent discover currencies, quote, route, and execute stablecoin swaps through one standard tool interface.",
  "type": "module",
  "homepage": "https://agents.sera.cx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sera-cx/sera-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sera-cx/sera-mcp/issues"
  },
  "license": "MIT",
  "mcpName": "io.github.sera-cx/sera-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "ai-agents",
    "agent-tools",
    "x402",
    "stablecoin",
    "fx",
    "foreign-exchange",
    "cross-border-payments",
    "settlement",
    "eip-712",
    "streamable-http",
    "sera"
  ],
  "bin": {
    "sera-mcp": "dist/index.js",
    "sera": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "SECURITY.md",
    "SECURITY-MODEL.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run test && npm run audit",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "better-sqlite3": "^12.10.0",
    "ethers": "^6.13.4",
    "express": "^4.21.0",
    "undici": "^6.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.0",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "qs": "^6.15.2",
    "ws": "^8.21.0",
    "@hono/node-server": "^1.19.9"
  },
  "engines": {
    "node": ">=18.17"
  }
}
